<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Warnings stay visible locally but fail the build on CI. -->
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pkcs 9.0.11 comes in transitively; SignedCms/EnvelopedCms are not used. Remove after pinning 10.0.13. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-846f-f764-76mx" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2fmv-rv2c-59x7" />
  </ItemGroup>

</Project>
