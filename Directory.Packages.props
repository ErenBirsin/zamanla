<Project>

  <!-- Central Package Management: NuGet paketlerinin sürümleri yalnızca burada yazılır.
       Projeler .csproj içinde paketi sürümsüz ekler; böylece aynı paketin iki farklı sürümü olamaz. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="WebAPI">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
  </ItemGroup>

</Project>
